# ==============================================================================
# AI Event Lead Manager — Environment Variables Example
# Copy this file to `.env.local` for local development.
# NEVER commit real credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# PUBLIC: Project URL (Accessible on both client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# PUBLIC: Anonymous key (Read-only client queries or public auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SERVER-ONLY SECRET: Privileged service role key (CRITICAL)
# - Used exclusively by Next.js Route Handlers / Server Components to perform CRUD operations
# - Bypasses Row Level Security (RLS) on the backend
# - MUST NEVER be prefixed with NEXT_PUBLIC_
# - MUST NEVER be imported into client components or returned in API responses
# - MUST NEVER be committed to Git (kept safe in .env.local)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# AI Provider Configuration (Server-Side Only)
# The application supports OpenAI, Google Gemini, Anthropic, or an OpenAI-compatible endpoint.
# If no key is configured, the application automatically uses the built-in
# local deterministic NLP fallback engine so features remain 100% testable.
# ------------------------------------------------------------------------------
AI_API_KEY=your-ai-api-key-here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Provider-specific alternatives:
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
